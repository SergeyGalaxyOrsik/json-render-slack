{
  "root": "card",
  "elements": {
    "card": { "type": "Card", "props": { "title": "Search analytics", "subtitle": "Last 7 days" }, "children": ["fields", "c1", "c2", "c3"] },
    "fields": { "type": "Fields", "props": {}, "children": ["f1", "f2"] },
    "f1": { "type": "Field", "props": { "label": "Searches", "value": "12,400" } },
    "f2": { "type": "Field", "props": { "label": "Top page", "value": "/search?q=<term>&page=2" } },
    "c1": { "type": "Chart", "props": { "title": "Searches per day", "chart": { "type": "line", "categories": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"], "series": [{ "name": "Searches", "values": [1500, 1800, 1700, 2100, 2000, 1600, 1700] }] } } },
    "c2": { "type": "Chart", "props": { "title": "Top queries", "chart": { "type": "bar", "categories": ["wireless noise cancelling headphones", "wireless noise cancelling earbuds", "usb-c charger"], "series": [{ "name": "Searches", "values": [420, 380, 300] }] } } },
    "c3": { "type": "Chart", "props": { "title": "Devices", "chart": { "type": "pie", "segments": [{ "label": "Mobile", "value": 62 }, { "label": "Desktop", "value": 35 }, { "label": "Tablet", "value": 3 }] } } }
  }
}
